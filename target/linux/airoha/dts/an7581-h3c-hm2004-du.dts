/dts-v1/;

/*
 * H3C HM2004-DU - FTTR master gateway (China Unicom variant).
 *
 * Airoha AN7581CT, quad A53 @ 900 MHz, 512 MiB DRAM (stock env
 * dram_limit=512M - the stock DTB's 8 GiB node is bogus), 256 MiB
 * SPI-NAND. XG-PON / 10G-EPON upstream through the internal xPON MAC
 * with an EN7572-class BOSA (UX3326; calibration at 0x1c0400).
 *
 * Downstream: 1x 2.5GE (EN8811H, external MDIO) + 3x GE (internal GSW
 * PHYs) + USB 2.0 + MT7916 (MT7916AN + MT7976DN, DBDC 2x2) + POTS
 * (SLIC, no driver ported). The FTTR downlink towards the slave
 * gateways is an H3C FMCS FPGA - see the fmcs node.
 */

/* Firmware reserves the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"

/ {
	model = "H3C HM2004-DU";
	compatible = "h3c,hm2004-du", "airoha,an7581", "airoha,en7581";

	aliases {
		label-mac-device = &gdm4;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;

		serial0 = &uart1;
	};

	chosen {
		/* fitblk locates the FIT-embedded read-only rootfs volume. */
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	/* Stock U-Boot env sets dram_limit=512M and patches the DTB. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/* TODO(verify): GPIO0 is the TCLinux SDK default; no button
			 * record exists in the stock flash. */
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		/*
		 * All lamps are active-low (verified on hardware). GPIO17/18/19/
		 * 15/34 were each confirmed to light; GPIO12 and GPIO20 are still
		 * unconfirmed (stock env ether_gpio=0c / internet_gpio=14).
		 * GPIO16 (red power) and GPIO21 (downlink) light nothing on this
		 * board and are deliberately not declared.
		 */
		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

		led-pon {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
			/* Registration maps O1-O3 to fast blink, O4 to slow blink, and O5 on. */
			linux,default-trigger = "pon0-registration";
		};

		led-los {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-los";
		};

		led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			/* TODO(verify): stock env internet_gpio=14 -> 0x14; not measured. */
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};

		led-wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led-lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			/* TODO(verify): stock env ether_gpio=0c -> 0x0c; not measured. */
			gpios = <&en7581_pinctrl 12 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port1>;
		};
	};

	/* The USB PHY 3.3V reference supply is always on. */
	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "fixed-3.3V";
	};

	/*
	 * Reserved node for the FTTR downstream optical port (下行光口).
	 * Stock DTB: compatible "h3c,fmcs" plus spi-controller = <11>,
	 * fpga-spi-int-gpio = <23>, interrupts = <0 26 1> (GIC_SPI 26,
	 * level-high) and fpga-load-{rst,cfg-done,flag,clk,do}-gpio = <0>:
	 * an FPGA whose bitstream is bit-banged over GPIO and which then
	 * speaks SPI. Stock env fttr_olt_sel=4 - the master runs in OLT mode
	 * towards the slave gateways (mtd5/mtd6/mtd7 hold the slave
	 * kernel/rootfs/tclinux images it serves over this port).
	 *
	 * Nothing else can be reserved for it: AN7581 wires only gdm1 (CPU),
	 * gdm2 (PON) and gdm4 (2.5GE) - there is no gdm3, so the downlink can
	 * never become an airoha,eth-mac netdev - and next to pon_pcs /
	 * eth_pcs / usb_pcs the only PCS block left (pcs@1fa04000) is
	 * "airoha,an7581-pcs-pcie", i.e. PCIe. A driver must talk SPI with
	 * GPIO23 as IRQ. The stock mdio-bus also lists 0x0d/0x0e beside the
	 * EN8811H at 0x0f - most likely this FPGA's port PHYs, left
	 * undeclared so they do not probe as phantom PHYs. No lamp either:
	 * GPIO21, assumed to be the downlink lamp, does not light.
	 *
	 * Skeleton once a binding exists:
	 *   fmcs {
	 *       compatible = "h3c,fmcs";
	 *       spi-controller = <11>;
	 *       interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
	 *       fpga-spi-int-gpios = <&en7581_pinctrl 23 GPIO_ACTIVE_HIGH>;
	 *       status = "okay";
	 *   };
	 */
	fmcs {
		compatible = "h3c,fmcs";
		status = "disabled";
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	pon_pins: pon-pins {
		mux {
			/* Leave GPIO38/TX_DISABLE under optical frontend control. */
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio46";
		};
	};
};

/* The stock flash is SPI-NAND accessed through the SNFI (SPI2NFI) engine. */
&snfi {
	status = "okay";
};

&spi_nand {
	nand-ecc-engine = <&spi_nand>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* BootROM reads the BL2 FIP at offset 0x800 in the first eraseblock. */
		partition@0 {
			label = "bl2";
			reg = <0x00000000 0x00020000>;
			read-only;
		};

		/* UBI manages every eraseblock after BL2. */
		partition@20000 {
			label = "ubi";
			reg = <0x00020000 0x00000000>;
			compatible = "linux,ubi";

			volumes {
				ubi_fip: ubi-volume-fip {
					/* The second-stage FIP contains BL31 and U-Boot. */
					volname = "fip";
				};

				ubi_env: ubi-volume-ubootenv {
					volname = "ubootenv";
				};

				ubi_env2: ubi-volume-ubootenv2 {
					volname = "ubootenv2";
				};

				factory: ubi-volume-factory {
					volname = "factory";

					/*
					 * This board's factory UBI volume is 1 MiB (0x100000),
					 * so the vendor's "true" offsets (0x140005 / 0x14102c /
					 * 0x1c0400 / 0x4c000, which live in the 0x240000-byte
					 * reservearea) are out of range here. Use the compact
					 * 1 MiB layout defined by the h3c-hm2004du-factory
					 * editor (github.com/qwe3017/h3c-hm2004du-factory):
					 *   0x0000  magic "H3C-1MiB" (8 ASCII bytes)
					 *   0x0010  label MAC, six raw bytes
					 *   0x0020  eth0 MAC (label+1, informational copy)
					 *   0x0030  pon0 MAC (label+2, informational copy)
					 *   0x0040  5G MAC (label+4, informational copy)
					 *   0x0050  2.4G MAC (label+5, informational copy)
					 *   0x0060  Device SN, 12-byte ASCII
					 *   0x1000  Wi-Fi EEPROM, 0x1000 (MT7916 DBDC)
					 *   0x2000  PON calibration, 0x200 (EN7572)
					 */
					h3c_hm2004du_layout: nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						factory_magic: magic@0 {
							reg = <0x00000000 0x00000008>;
						};

						/* Base MAC: label plus all per-unit derivations
						 * via the mac-base read_post_process (index added
						 * to the last byte). The cell only yields usable
						 * addresses once the volume is seeded with the
						 * real bytes; an erased slot reads as ff:ff:... */
						base_mac: base-mac@10 {
							compatible = "mac-base";
							reg = <0x00000010 0x00000006>;
							#nvmem-cell-cells = <1>;
						};

						pon_serial: pon-serial@60 {
							reg = <0x00000060 0x0000000c>;
						};

						pon_calibration: calibration@2000 {
							reg = <0x00002000 0x00000200>;
						};

						wifi_eeprom: eeprom@1000 {
							reg = <0x00001000 0x00001000>;
						};
					};
				};

				ubi_fit: ubi-volume-fit {
					/* The fit volume contains the kernel and read-only rootfs. */
					volname = "fit";
				};
			};
		};
	};
};

/*
 * All MACs derive from the six raw bytes at factory offset 0x10 (compact
 * 1 MiB layout) through the mac-base cell above - the same
 * read_post_process scheme the Nokia XG-040G boards use. The stock
 * reservearea keeps only the locally administered placeholder
 * 02:00:00:XX:00:00 in its own slot (the real address lives inside the gzip
 * ctromfile at 0x80000 of the 0x240000-byte dump), so the volume must be
 * seeded once before these cells mean anything:
 *
 *   factory-h3c-hm2004du-seed-1mib.bin = compact 1 MiB image carrying the
 *   real label MAC, SN, Wi-Fi EEPROM and PON calibration, flashed with
 *   ubiupdatevol.
 *
 * Derivations (matching the h3c-hm2004du-factory editor): lan1/gdm4 = label,
 * gdm1/eth0 = label+1, pon0/gdm2 = label+2, 5G radio = label+4, 2.4G radio
 * = label+5. The lan bridge keeps its address from 02_network, which reads
 * the label back out of lan1 in sysfs (netifd does not push a macaddr onto
 * the bridge device itself).
 */
&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&i2c0 {
	status = "okay";

	/*
	 * UX3326 BOSA assembly driven by the EN7572-compatible controller;
	 * reservearea calibration header names the chip explicitly.
	 */
	en7572: optical-front-end@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;
		/* GPIO38 high disables upstream optical transmission. */
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
	};
};

/* USB 2.0 host port (product spec: 1x USB2.0; stock env serdes_usb1=11). */
&usb0 {
	status = "okay";
	vusb33-supply = <&reg_3p3v>;
	#address-cells = <1>;
	#size-cells = <0>;

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";

	/* eth0 is the internal FE/GMAC netdev; it takes label+1 from the
	 * factory mac-base cell. */
};

&gdm1 {
	/* eth0's GMAC port: label+1, one above the LAN side. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 1>;
	status = "okay";
};

&mdio {
	/* Reserved for the FMCS downlink FPGA (see the fmcs node): the stock
	 * bus also lists 0x0d/0x0e beside the EN8811H at 0x0f. They are not
	 * declared - no driver, so they would only probe as phantom PHYs -
	 * and must not be reused for anything else. */

	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;
		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		/* Hold reset for 1 second and wait 100 ms before MD32 firmware load. */
		reset-assert-us = <1000000>;
		reset-deassert-us = <100000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led-0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&eth_pcs {
	/* HSGMII carries the EN8811H 2500BASE-X host link. */
	status = "okay";
};

&gdm4 {
	openwrt,netdev-name = "lan1";
	phy-handle = <&en8811>;
	phy-mode = "2500base-x";
	/* lan1 carries the plain label MAC. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 0>;
	status = "okay";
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

/*
 * Panel LAN2, LAN3, LAN4 map to the internal GSW PHYs 2, 3, and 4
 * (panel 2.5GE is LAN1 via EN8811H above).
 */
&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_phy2 {
	interrupts = <2>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
	status = "okay";
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_phy3 {
	interrupts = <3>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
	status = "okay";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy4 {
	interrupts = <4>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
	status = "okay";
};

&gsw_phy4_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	active-low;
	status = "okay";
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&en7572>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	/* XG-PON/10G-EPON upstream; GPON mode is selected by ponctl.
	 * label+2 from the factory mac-base cell, so the two L2 domains
	 * do not collide. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 2>;
	airoha,pon-data-path;
	status = "okay";
};

&en7581_pinctrl {
	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};
};

&pcie0 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
		};
	};
};

&pcie1 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
			mediatek,eeprom-merge-otp;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			/* The EEPROM only ships the Ralink placeholder
			 * 00:0c:43:26:60:00, so both bands take their address
			 * from the factory mac-base cell, with the same
			 * per-band pattern as an7581-nokia-valyrian. Verify the
			 * band order on the running unit ("iw phyN bands") and
			 * swap the two indices if 2.4G ends up on band 0. */
			band@0 {
				reg = <0>;
				nvmem-cells = <&base_mac 5>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&base_mac 4>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};
